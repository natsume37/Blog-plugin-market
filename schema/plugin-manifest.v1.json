{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/natsume37/Blog-plugin-market/schema/plugin-manifest.v1.json",
  "title": "Blog Plugin Market Manifest v1",
  "type": "object",
  "required": ["schema_version", "plugin_id", "name", "version", "description", "category", "delivery"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "plugin_id": { "type": "string", "minLength": 2 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "summary": { "type": "string" },
    "category": { "type": "string" },
    "source": { "type": "string" },
    "icon": { "type": "string" },
    "author": { "type": "string" },
    "publisher": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "verified": { "type": "boolean" }
      }
    },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "features": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "compatibility": {
      "type": "object",
      "properties": {
        "backend": { "type": "string" },
        "frontend": { "type": "string" },
        "min_app_version": { "type": "string" },
        "max_app_version": { "type": "string" }
      }
    },
    "delivery": {
      "type": "object",
      "required": ["type", "entry_mode", "install_strategy", "runtime_type"],
      "properties": {
        "type": { "type": "string" },
        "entry_mode": { "type": "string" },
        "install_strategy": { "type": "string" },
        "runtime_type": { "type": "string" },
        "entry_url": { "type": "string" }
      }
    }
  }
}
